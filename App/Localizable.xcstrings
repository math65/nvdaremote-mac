      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la fenêtre de connexion"
          }
        }
      }
    },
    "Show in the Dock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans le Dock"
          }
        }
      }
    },
    "Show in the menu bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans la barre des menus"
          }
        }
      }
    },
    "Sounds": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
