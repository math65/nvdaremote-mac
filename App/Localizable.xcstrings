{
  "sourceLanguage": "en",
  "strings": {
    "%@ on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@"
          }
        }
      }
    },
    "%lld words per minute": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mots par minute"
          }
        }
      }
    },
    "As in NVDA: the PC's speech and sounds stop while you work on the Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme dans NVDA : la parole et les sons du PC s'arrêtent pendant que vous travaillez sur le Mac."
          }
        }
      }
    },
    "Browse mode, focus mode, errors and other NVDA sounds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode navigation, mode formulaire, erreurs et autres sons de NVDA."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Caps Lock could not be restored: %@ Restarting the Mac will restore it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage majuscules n'a pas pu être rétablie : %@ Un redémarrage du Mac la rétablira."
          }
        }
      }
    },
    "Certificate to verify.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificat à vérifier."
          }
        }
      }
    },
    "channel key, or nvdaremote:// link": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "clé du canal, ou lien nvdaremote://"
          }
        }
      }
    },
