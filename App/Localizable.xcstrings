            "state": "translated",
            "value": "NVDA Remote"
          }
        }
      }
    },
    "One of the two always stays visible.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une des deux reste toujours visible."
          }
        }
      }
    },
    "One of the two always stays visible. With the menu bar icon, the Dock icon only shows while the Connection window is open.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une des deux reste toujours visible. Avec l'icône de la barre des menus, l'icône du Dock n'apparaît que lorsque la fenêtre de connexion est ouverte."
          }
        }
      }
    },
